cc_library_shared {
    name: "libsdmdal",
    defaults: ["qtidisplay_defaults"],
    header_libs: [
        "display_core_headers",
        "libdrmutils_local_headers_nx809j",
        "nx809j_qti_display_uapi",
    ], // NX809J: utils/formats.h + drm_lib_loader.h
    sanitize: {
        integer_overflow: true,
    },
    vendor: true,
    cflags: [
        "-fno-operator-names",
        "-Wno-unused-parameter",
        "-DLOG_TAG=\"SDM\"",
    ],
    shared_libs: [
        "libdisplaydebug",
        "libsdmutils",
        "libdrm",
        "libdrmutils",
        "libsdedrm",
    ],

    srcs: [
        "hw_events_interface.cpp",
        "hw_info_interface.cpp",
        "hw_interface.cpp",
        "hw_info_drm.cpp",
        "hw_device_drm.cpp",
        "hw_peripheral_drm.cpp",
        "hw_tv_drm.cpp",
        "hw_events_drm.cpp",
        "hw_scale_drm.cpp",
        "hw_virtual_drm.cpp",
        "hw_color_manager_drm.cpp",
    ],

}
